{
  "name": "polka",
  "private": true,
  "type": "module",
  "description": "Frontend toolchain for polka — bundling, typecheck, and browser tests.",
  "scripts": {
    "build": "node frontend/build.mjs",
    "typecheck": "tsc --noEmit -p frontend/tsconfig.json && tsc --noEmit -p browser-test/tsconfig.json",
    "lint": "biome check frontend/*.mjs frontend/src frontend/test browser-test biome.json",
    "lint:fix": "biome check --write frontend/*.mjs frontend/src frontend/test browser-test biome.json",
    "test:unit": "node --test frontend/test/*.test.mjs",
    "test:browser-list": "cd browser-test && playwright test --list >/dev/null",
    "e2e": "cd browser-test && playwright test",
    "screenshot": "node browser-test/screenshot.mjs"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.13.6",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "foliate-js": "github:levmv/foliate-js#83efc18471be41cc129dbc63ff5a13e20a8009af",
    "pdfjs-dist": "6.3.289"
  }
}
